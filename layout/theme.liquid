    {%- comment -%} Popup & UI Skripte (CDN) {%- endcomment -%}
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        function appendPopupScript() {
          var popupScript = document.createElement('script');
          popupScript.src = '{{ 'popup.js' | asset_url }}';
          popupScript.defer = true;
          document.head.appendChild(popupScript);
        }

        if (window.jQuery) {
          appendPopupScript();
        } else {
          var jq = document.createElement('script');
          jq.src = '{{ 'jquery.js' | asset_url }}';
          jq.defer = true;
          jq.onload = appendPopupScript;
          jq.onerror = appendPopupScript;
          document.head.appendChild(jq);
        }
      });
    </script>

