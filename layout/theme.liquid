    {%- comment -%} 🟢 AI-Traffic Tracking (optimiert) {%- endcomment -%}
    <script>
    (function() {
      const ref = document.referrer.toLowerCase();
      const aiSources = ['chatgpt.com', 'openai.com', 'gemini.google.com', 'claude.ai', 'perplexity.ai'];
      const isAI = aiSources.some(src => ref.includes(src)) || window.location.search.includes('utm_source=chatgpt');

      if (!isAI) { return; }

      function getCookie(name) {
        const match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
        return match ? decodeURIComponent(match[2]) : null;
      }

      function hasConsent() {
        const localConsent = getCookie('brewblend_tracking_consent');
        if (localConsent === 'accepted') return true;
        if (localConsent === 'declined') return false;

        const consentCookies = [
          { name: 'cookieconsent_status', value: 'allow' },
          { name: 'CookieConsent', value: 'allow' },
          { name: 'OptanonConsent' },
          { name: 'euconsent-v2' }
        ];

        return consentCookies.some(cookie => {
          const value = getCookie(cookie.name);
          if (!value) return false;
          return !cookie.value || value.toLowerCase() === cookie.value.toLowerCase();
        });
      }

      if (!hasConsent()) { return; }

      function sendTrafficData(payload) {
        const endpoint = 'https://brew-blend-outreach.vercel.app/api/traffic';
        const bodyString = JSON.stringify(payload);

        if (navigator.sendBeacon) {
          const blob = new Blob([bodyString], { type: 'application/json' });
          navigator.sendBeacon(endpoint, blob);
          return;
        }

        fetch(endpoint, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: bodyString,
          keepalive: true,
          mode: 'no-cors'
        }).catch(() => {
          // Still avoid CORS noise by catching all network failures
        });
      }

      sendTrafficData({
        source: 'KI-Referral',
        path: window.location.pathname,
        type: navigator.userAgent.toLowerCase().includes('bot') ? 'bot' : 'human'
      });
    })();
    </script>

    <script>
      (function() {
        const gtmId = 'GTM-TH9VLGB5';
        const localConsentName = 'brewblend_tracking_consent';
        const knownConsentCookies = [
          { name: 'cookieconsent_status', value: 'allow' },
          { name: 'CookieConsent', value: 'allow' },
          { name: 'OptanonConsent' },
          { name: 'euconsent-v2' },
          { name: 'konvajs_cookie_consent' },
          { name: 'cc_cookie_accept' }
        ];

        function getCookie(name) {
          const match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
          return match ? decodeURIComponent(match[2]) : null;
        }

        function hasConsent() {
          const local = getCookie(localConsentName);
          if (local === 'accepted') return true;
          if (local === 'declined') return false;

          for (const cookie of knownConsentCookies) {
            const value = getCookie(cookie.name);
            if (!value) continue;
            if (!cookie.value || value.toLowerCase() === cookie.value.toLowerCase()) {
              return true;
            }
          }

          return false;
        }

        function loadGTM() {
          if (window.brewblendGtmLoaded) return;
          window.brewblendGtmLoaded = true;
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          const f = document.getElementsByTagName('script')[0];
          const j = document.createElement('script');
          j.async = true;
          j.src = 'https://www.googletagmanager.com/gtm.js?id=' + gtmId;
          f.parentNode.insertBefore(j, f);
        }

        loadGTM();
      })();
    </script>
