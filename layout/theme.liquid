<!DOCTYPE html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.theme_color }}">
    
    {%- comment -%} 🔴 SEO FIX #1: ROBOTS META TAG - KRITISCH! {%- endcomment -%}
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
    {%- if settings.google_site_verification != blank -%}
      <meta name="google-site-verification" content="{{ settings.google_site_verification }}">
    {%- endif -%}
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- assign og_locale = request.locale.iso_code | upcase -%}
    {%- if og_locale == 'DE' -%}
      {%- assign og_locale = 'de_DE' -%}
    {%- elsif og_locale == 'EN' -%}
      {%- assign og_locale = 'en_US' -%}
    {%- elsif og_locale == 'IT' -%}
      {%- assign og_locale = 'it_IT' -%}
    {%- endif -%}
    <meta property="og:locale" content="{{ og_locale }}">

    {%- comment -%} 🟢 SEO FIX #2: HREFLANG TAGS für DE/EN/IT {%- endcomment -%}
    {%- if localization.available_languages.size > 1 -%}
      {%- for language in localization.available_languages -%}
        <link rel="alternate" hreflang="{{ language.iso_code }}" href="{{ canonical_url | replace: request.locale.root_url, language.root_url }}">
      {%- endfor -%}
      <link rel="alternate" hreflang="x-default" href="{{ canonical_url }}">
    {%- endif -%}

    {%- comment -%} 
      1. FRÜHE INITIALISIERUNG (Fix für ReferenceError: Shopify is not defined)
      Muss ganz oben stehen, bevor andere Skripte geladen werden.
    {%- endcomment -%}
    <script>
      window.Shopify = window.Shopify || {};
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      if (window.Shopify.designMode) { document.documentElement.classList.add('shopify-design-mode'); }

      (function() {
        var path = window.location.pathname || '/';
        var search = window.location.search || '';
        var hash = window.location.hash || '';
        var target = null;

        if (path === '/da' || path === '/da/') {
          target = '/' + search + hash;
        } else if (path.startsWith('/da/')) {
          target = path.replace(/^\/da/, '') || '/';
          target += search + hash;
        } else if (path === '/en' || path === '/en/') {
          target = '/' + search + hash;
        } else if (path.startsWith('/en/')) {
          target = path.replace(/^\/en/, '') || '/';
          target += search + hash;
        }

        if (target) {
          window.location.replace(target);
        }
      })();
    </script>

    {%- comment -%} Performance & SEO Optimierung (DACH / E-E-A-T 2026) {%- endcomment -%}
    {%- comment -%} 
      Behebung der "RemoteAsset" Warnung: 
      Wir beschränken uns auf die Shopify-eigenen CDN-Ursprünge im Head.
      GTM wird erst bei Interaktion verbunden, um Verbindungs-Slots für LCP zu sparen.
    {%- endcomment -%}
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdn.shopify.com">
    <link rel="dns-prefetch" href="https://fonts.shopifycdn.com">
    
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}
    <link rel="manifest" href="{{ 'manifest.json' | asset_url }}">

    {%- comment -%} 🟢 SEO FIX #3: OPTIMIERTE TITLE TAGS mit Template-Logik {%- endcomment -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "url": "{{ shop.url }}",
        "name": "{{ shop.name }}",
        "inLanguage": "de-DE",
        "potentialAction": {
          "@type": "SearchAction",
          "target": "{{ shop.url }}/search?q={search_term_string}",
          "query-input": "required name=search_term_string"
        }
      }
    </script>

    <title>
      {%- if page_title == blank -%}
        Premium Kaffee & Tee aus Deutschland
      {%- elsif template.name == 'product' -%}
        {{ product.title }}{%- if product.vendor != blank -%} | {{ product.vendor }}{%- endif -%}
      {%- elsif template.name == 'collection' -%}
        {{ collection.title }}
      {%- elsif template.name == 'article' -%}
        {{ article.title }} | Blog
      {%- elsif template.name == 'page' -%}
        {{ page.title }}
      {%- else -%}
        {{ page_title }}
      {%- endif -%}
    </title>
    
    <meta name="description" content="{{ page_description | default: product.description | default: collection.description | default: article.excerpt | default: shop.description | default: 'Premium Kaffee & Tee aus Deutschland ✓ Coffeebrewer ✓ Nachhaltige Verpackung ✓ Schnelle Lieferung ✓ Jetzt bei Brew Blend bestellen!' | strip_html | escape }}">
    <meta name="author" content="{{ shop.name }}">
    <meta name="publisher" content="{{ shop.name }}">
    <meta name="keywords" content="{%- if request.page_type == 'product' -%}{{ product.tags | join: ', ' | default: 'kaffeebohnen, coffee beans, kaffee geschenke, tee geschenke' }}{%- elsif request.page_type == 'collection' -%}{{ collection.title }}, {{ collection.handle }}, kaffeebohnen, coffee beans, kaffee geschenke, tee geschenke{%- elsif request.page_type == 'article' -%}{{ article.tags | join: ', ' | default: 'kaffeebohnen, coffee beans, kaffee geschenke, tee geschenke' }}{%- else -%}kaffeebohnen, coffee beans, kaffee geschenke, tee geschenke{%- endif -%}">

    {% render 'meta-tags' %}

    {%- comment -%} Kritische Skripte mit defer laden (CDN-hosted via Shopify) {%- endcomment -%}
    <script src="{{ 'constants.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'pubsub.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    {%- if settings.animations_reveal_on_scroll -%}
      <script src="{{ 'animations.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {{ content_for_header }}

    {%- liquid
      assign body_font_bold = settings.type_body_font | font_modify: 'weight', 'bold'
      assign body_font_italic = settings.type_body_font | font_modify: 'style', 'italic'
      assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
    %}

    {% style %}
      {{ settings.type_body_font | font_face: font_display: 'swap' }}
      {{ body_font_bold | font_face: font_display: 'swap' }}
      {{ body_font_italic | font_face: font_display: 'swap' }}
      {{ body_font_bold_italic | font_face: font_display: 'swap' }}
      {{ settings.type_header_font | font_face: font_display: 'swap' }}
      {{ settings.type_menu_font | font_face: font_display: 'swap' }}
      {{ settings.type_header_italic_font | font_face: font_display: 'swap' }}
      {{ settings.type_collapsible_font  | font_face: font_display: 'swap' }}

      {% assign scheme_classes = '' %}
      {% for scheme in settings.color_schemes -%}
        {% assign scheme_classes = scheme_classes | append: ', .color-' | append: scheme.id %}
        {% if forloop.index == 1 -%}
          :root,
        {%- endif %}
        .color-{{ scheme.id }} {
          --color-background: {{ scheme.settings.background.red }},{{ scheme.settings.background.green }},{{ scheme.settings.background.blue }};
          {% if scheme.settings.background_gradient != empty %}
            --gradient-background: {{ scheme.settings.background_gradient }};
          {% else %}
            --gradient-background: {{ scheme.settings.background }};
          {% endif %}

          {% liquid
            assign background_color = scheme.settings.background
            assign background_color_brightness = background_color | color_brightness
            if background_color_brightness <= 26
              assign background_color_contrast = background_color | color_lighten: 50
            elsif background_color_brightness <= 65
              assign background_color_contrast = background_color | color_lighten: 5
            else
              assign background_color_contrast = background_color | color_darken: 25
            endif
          %}

          --color-foreground: {{ scheme.settings.text.red }},{{ scheme.settings.text.green }},{{ scheme.settings.text.blue }};
          --color-background-contrast: {{ background_color_contrast.red }},{{ background_color_contrast.green }},{{ background_color_contrast.blue }};
          --color-shadow: {{ scheme.settings.shadow.red }},{{ scheme.settings.shadow.green }},{{ scheme.settings.shadow.blue }};
          --color-button: {{ scheme.settings.button.red }},{{ scheme.settings.button.green }},{{ scheme.settings.button.blue }};
          --color-button-text: {{ scheme.settings.button_label.red }},{{ scheme.settings.button_label.green }},{{ scheme.settings.button_label.blue }};
          --color-secondary-button: {{ scheme.settings.background.red }},{{ scheme.settings.background.green }},{{ scheme.settings.background.blue }};
          --color-secondary-button-text: {{ scheme.settings.secondary_button_label.red }},{{ scheme.settings.secondary_button_label.green }},{{ scheme.settings.secondary_button_label.blue }};
          --color-link: {{ scheme.settings.secondary_button_label.red }},{{ scheme.settings.secondary_button_label.green }},{{ scheme.settings.secondary_button_label.blue }};
          --color-badge-foreground: {{ scheme.settings.text.red }},{{ scheme.settings.text.green }},{{ scheme.settings.text.blue }};
          --color-badge-background: {{ scheme.settings.background.red }},{{ scheme.settings.background.green }},{{ scheme.settings.background.blue }};
          --color-badge-border: {{ scheme.settings.text.red }},{{ scheme.settings.text.green }},{{ scheme.settings.text.blue }};
          --payment-terms-background-color: rgb({{ scheme.settings.background.rgb }});
          --sale-price: rgb({{ settings.sale_price.rgb }});
        }
      {% endfor %}

      {{ scheme_classes | prepend: 'body' }} {
        color: rgba(var(--color-foreground), 0.95);
        background-color: rgb(var(--color-background));
      }

