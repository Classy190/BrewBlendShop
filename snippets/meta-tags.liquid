{%- comment -%} 🟢 SEO FIX: Smart Meta-Description Generation {%- endcomment -%}
{%- comment -%} 🔴 CRITICAL: Product Availability - Use selected variant, not product level {%- endcomment -%}

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'

  assign meta_description = page_description
  assign product_is_available = true

  if request.page_type == 'product' and product
    assign og_type = 'product'
    assign current_variant = product.selected_or_first_available_variant

    if current_variant == blank
      assign current_variant = product.variants.first
    endif

    if current_variant
      assign product_is_available = current_variant.available
    endif

    if page_description != blank
      assign meta_description = page_description | strip_html | truncate: 160
    elsif product.description != blank
      assign meta_description = product.description | strip_html | truncate: 160
    else
      assign meta_description = product.title | append: " - Specialty Coffee, Kaffeebohnen, Coffee Brewer oder Premium Tee online bestellen. Fair gehandelt, nachhaltig ausgewählt, Versand aus Dänemark."
    endif

  elsif request.page_type == 'collection' and collection
    if page_description != blank
      assign meta_description = page_description | strip_html | truncate: 160
    elsif collection.description != blank
      assign meta_description = collection.description | strip_html | truncate: 160
    else
      assign meta_description = collection.title | append: " online kaufen bei Brew Blend: Specialty Coffee, Kaffeebohnen, Coffee Brewer und Premium Tee. Nachhaltig ausgewählt, Versand aus Dänemark."
    endif

  elsif request.page_type == 'article' and article
    assign og_type = 'article'

    if page_description != blank
      assign meta_description = page_description | strip_html | truncate: 160
    elsif article.excerpt != blank
      assign meta_description = article.excerpt | strip_html | truncate: 160
    elsif article.content != blank
      assign meta_description = article.content | strip_html | truncate: 160
    else
      assign meta_description = article.title | append: " - Kaffee-Wissen, Tipps zu Specialty Coffee, Kaffeebohnen, Coffee Brewer und Tee von Brew Blend."
    endif

  elsif request.page_type == 'password'
    assign og_url = request.origin
    assign meta_description = "Brew Blend Shop - Specialty Coffee, Kaffeebohnen, Coffee Brewer und Premium Tee online entdecken. Nachhaltig ausgewählt, Versand aus Dänemark."

  else
    if page_description != blank
      assign meta_description = page_description | strip_html | truncate: 160
    else
      assign meta_description = "Brew Blend - Specialty Coffee, Kaffeebohnen, Coffee Brewer und Premium Tee online kaufen. Fair gehandelt, nachhaltig ausgewählt, Versand aus Dänemark."
    endif
  endif
-%}

{%- comment -%} 🔴 CRITICAL: Meta Description for Google indexation {%- endcomment -%}
<meta name="description" content="{{ meta_description | escape }}">

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ meta_description | escape }}">

{%- comment -%} 🔴 SEO FIX: HTTPS statt HTTP für og:image {%- endcomment -%}
{%- if page_image -%}
  <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ page_image.alt | default: og_title | escape }}">
{%- elsif settings.share_image -%}
  <meta property="og:image" content="https:{{ settings.share_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ settings.share_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ settings.share_image.alt | default: og_title | escape }}">
{%- endif -%}

{%- if request.page_type == 'product' and product -%}
  {%- if current_variant -%}
    <meta property="product:price:amount" content="{{ current_variant.price | divided_by: 100.0 }}">
  {%- endif -%}
  <meta property="product:price:currency" content="{{ cart.currency.iso_code | default: shop.currency }}">
  <meta property="product:brand" content="{{ product.vendor | default: shop.name | escape }}">
  <meta property="product:availability" content="{% if product_is_available %}in stock{% else %}out of stock{% endif %}">
  <meta property="product:condition" content="new">
{%- endif -%}

{%- comment -%} Twitter Card Meta Tags {%- endcomment -%}
{%- if settings.social_twitter_link != blank -%}
  {%- liquid
    assign twitter_handle = settings.social_twitter_link
    assign twitter_handle = twitter_handle | split: 'twitter.com/' | last
    assign twitter_handle = twitter_handle | split: 'x.com/' | last
    assign twitter_handle = twitter_handle | split: '/' | first
    assign twitter_handle = twitter_handle | remove: '@'
  -%}
  <meta name="twitter:site" content="@{{ twitter_handle }}">
  <meta name="twitter:creator" content="@{{ twitter_handle }}">
{%- endif -%}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ meta_description | escape }}">

{%- if page_image -%}
  <meta name="twitter:image" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta name="twitter:image:alt" content="{{ page_image.alt | default: og_title | escape }}">
{%- elsif settings.share_image -%}
  <meta name="twitter:image" content="https:{{ settings.share_image | image_url: width: 1200 }}">
  <meta name="twitter:image:alt" content="{{ settings.share_image.alt | default: og_title | escape }}">
{%- endif -%}

{%- comment -%} Pinterest Rich Pins {%- endcomment -%}
{%- if request.page_type == 'product' and product -%}
  <meta property="og:see_also" content="{{ shop.url }}{{ product.url }}">
{%- endif -%}