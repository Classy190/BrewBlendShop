{% comment %}
  product-variant-options.liquid
  Korrigiert: Zeigt "sold out" / "unavailable" NUR, wenn wirklich keine verfügbare Variante existiert.
  WICHTIG: Ersetze dein aktuelles Snippet im Ordner snippets/ damit.
{% endcomment %}

{%- liquid
  assign picker_type = block.settings.picker_type
  assign product_form_id = product_form_id | default: 'product-form-' | append: section.id
-%}

{%- for value in option.values -%}
  {%- assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index0 -%}
  {%- assign option_index = option.position | minus: 1 -%}

  {%- comment -%} Prüfe Verfügbarkeit über ALLE Varianten mit diesem Option-Wert {%- endcomment -%}
  {%- assign has_any_variant_with_value = false -%}
  {%- assign has_available_variant_with_value = false -%}
  {%- for variant in product.variants -%}
    {%- if variant.options[option_index] == value -%}
      {%- assign has_any_variant_with_value = true -%}
      {%- if variant.available -%}
        {%- assign has_available_variant_with_value = true -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}

  {%- assign is_unavailable = false -%}
  {%- assign is_sold_out = false -%}
  {%- if has_any_variant_with_value == false -%}
    {%- assign is_unavailable = true -%}
  {%- elsif has_available_variant_with_value == false -%}
    {%- assign is_sold_out = true -%}
  {%- endif -%}

  {%- if picker_type == 'button' -%}
    <input
      type="radio"
      id="{{ input_id }}"
      name="{{ option.name | handle }}"
      value="{{ value | escape }}"
      form="{{ product_form_id }}"
      {% if option.selected_value == value %}checked{% endif %}
      {% if is_unavailable or is_sold_out %}disabled{% endif %}
    >
    <label for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}">
      {{ value -}}
      {%- if option_disabled -%}
        <span class="visually-hidden">{{ 'products.product.variant_sold_out_or_unavailable' | t }}</span>
      {%- endif -%}
    </label>
  {%- else -%}
    <option
      value="{{ value | escape }}"
      {% if option.selected_value == value %}selected="selected"{% endif %}
      {% if is_unavailable or is_sold_out %}disabled{% endif %}
    >
      {{ value }}
      {%- if is_sold_out %} – Ausverkauft{%- endif -%}
    </option>
  {%- endif -%}
{%- endfor -%}
