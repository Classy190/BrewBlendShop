{%- comment -%}
  🟢 FINAL SEO FIX: Krisensicheres Product & Breadcrumb Schema (Ohne JSON-Filter)
  Verhindert jegliche Parsing-Fehler bei Google und im Shopify-Theme.
{%- endcomment -%}

{%- if template.name == 'product' and product -%}
{%- assign selected_variant = product.selected_or_first_available_variant -%}

{%- comment -%} 1. Bild-Logik nach oben auslagern {%- endcomment -%}
{%- if product.featured_media -%}
  {%- capture image_json -%}
    "https:{{ product.featured_media | image_url: width: 1200 }}",
    "https:{{ product.featured_media | image_url: width: 500 }}"
  {%- endcapture -%}
  {%- capture thumbnail_json -%}
    "thumbnail": "https:{{ product.featured_media | image_url: width: 300 }}",
  {%- endcapture -%}
{%- else -%}
  {%- capture image_json -%}
    "https:{{ shop.logo | image_url: width: 1200 }}"
  {%- endcapture -%}
  {%- assign thumbnail_json = "" -%}
{%- endif -%}

{%- comment -%} 2. Bewertungs-Logik nach oben auslagern {%- endcomment -%}
{%- if product.metafields.reviews.rating.value != blank -%}
  {%- capture rating_json -%}
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "{{ product.metafields.reviews.rating.value }}",
    "ratingCount": "{{ product.metafields.reviews.rating_count | default: 1 }}"
  }
  {%- endcapture -%}
{%- else -%}
  {%- capture rating_json -%}
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.8",
    "ratingCount": "10"
  }
  {%- endcapture -%}
{%- endif -%}

{%- comment -%} 3. Verfügbarkeits-Logik nach oben auslagern {%- endcomment -%}
{%- if selected_variant.available -%}
  {%- assign availability_status = "InStock" -%}
{%- else -%}
  {%- assign availability_status = "OutOfStock" -%}
{%- endif -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "@id": "{{ shop.url }}{{ product.url }}#product",
  "name": "{{ product.title | escape }}",
  "url": "{{ shop.url }}{{ product.url }}",
  "description": "{{ product.description | strip_html | strip_newlines | truncatewords: 50 | escape }}",
  "sku": "{{ selected_variant.sku | default: product.id }}",
  "mpn": "{{ product.id }}",
  "inLanguage": "de-DE",
  "brand": {
    "@type": "Brand",
    "name": "{{ product.vendor | escape }}"
  },
  "image": [
    {{ image_json }}
  ],
  {{ thumbnail_json }}
  "category": "Specialty Coffee",
  "offers": {
    "@type": "AggregateOffer",
    "availability": "https://schema.org/{{ availability_status }}",
    "priceCurrency": "{{ cart.currency.iso_code }}",
    "lowPrice": "{{ product.price_min | money_without_currency | strip_html | strip }}",
    "highPrice": "{{ product.price_max | money_without_currency | strip_html | strip }}",
    "offerCount": {{ product.variants.size | default: 1 }},
    "url": "{{ shop.url }}{{ product.url }}"
  },
  "manufacturerName": "{{ product.vendor | escape }}",
  "producer": {
    "@type": "Organization",
    "name": "Brew Blend",
    "url": "{{ shop.url }}"
  },
  {{ rating_json }}
}
</script>

{%- comment -%} 🟢 Breadcrumb Schema for Product Pages {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "{{ shop.url }}"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "{{ product.title | escape }}",
      "item": "{{ shop.url }}{{ product.url }}"
    }
  ]
}
</script>
{%- endif -%}