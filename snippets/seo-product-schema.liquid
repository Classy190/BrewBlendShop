{%- comment -%}
  🟢 FINAL SEO: Product & Breadcrumb Schema
  Konform mit Google Shopping, Merchant Center & AI Search Richtlinien.
  Inkl. Shipping, Returns, Video & Audience.
{%- endcomment -%}

{%- if template.name == 'product' and product -%}
{%- assign selected_variant = product.selected_or_first_available_variant -%}

{%- comment -%} 1. Bild-Logik {%- endcomment -%}
{%- if product.featured_media -%}
  {%- capture image_1 -%}https:{{ product.featured_media | image_url: width: 1200 }}{%- endcapture -%}
  {%- capture image_2 -%}https:{{ product.featured_media | image_url: width: 500 }}{%- endcapture -%}
  {%- capture thumb_img -%}https:{{ product.featured_media | image_url: width: 300 }}{%- endcapture -%}
{%- else -%}
  {%- capture image_1 -%}https:{{ shop.logo | image_url: width: 1200 }}{%- endcapture -%}
  {%- capture image_2 -%}https:{{ shop.logo | image_url: width: 1200 }}{%- endcapture -%}
  {%- capture thumb_img -%}https:{{ shop.logo | image_url: width: 300 }}{%- endcapture -%}
{%- endif -%}

{%- comment -%} 2. Bewertungs-Logik (NUR echte Reviews) {%- endcomment -%}
{%- assign rating_json = "" -%}
{%- if product.metafields.reviews.rating.value != blank and product.metafields.reviews.rating_count != blank -%}
  {%- capture rating_json -%}
  ,
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "{{ product.metafields.reviews.rating.value }}",
    "reviewCount": "{{ product.metafields.reviews.rating_count }}",
    "bestRating": "5",
    "worstRating": "1"
  }
  {%- endcapture -%}
{%- endif -%}

{%- comment -%} 3. Verfügbarkeits-Logik {%- endcomment -%}
{%- if selected_variant.available -%}
  {%- assign availability_status = "InStock" -%}
{%- else -%}
  {%- assign availability_status = "OutOfStock" -%}
{%- endif -%}

{%- comment -%} 4. Retouren-Logik (IMMER ausgeben) {%- endcomment -%}
{%- capture return_policy_json -%}
,
"hasMerchantReturnPolicy": {
  "@type": "MerchantReturnPolicy",
  "applicableCountry": "DE",
  "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
  "merchantReturnDays": "14",
  "returnMethod": "https://schema.org/ReturnByMail",
  "returnFees": "https://schema.org/ReturnFeesCustomerResponsibility"{% if shop.refund_policy %},
  "returnPolicyUrl": "{{ shop.url }}{{ shop.refund_policy.url }}"{% endif %}
}
{%- endcapture -%}

{%- comment -%} 5. Versand-Logik (IMMER ausgeben) {%- endcomment -%}
{%- capture shipping_json -%}
,
"shippingDetails": {
  "@type": "OfferShippingDetails",
  "shippingRate": {
    "@type": "MonetaryAmount",
    "value": "6.99",
    "currency": "EUR"
  },
  "shippingDestination": {
    "@type": "DefinedRegion",
    "addressCountry": "DE"
  },
  "deliveryTime": {
    "@type": "ShippingDeliveryTime",
    "handlingTime": {
      "@type": "QuantitativeValue",
      "minValue": 0,
      "maxValue": 1,
      "unitCode": "DAY"
    },
    "transitTime": {
      "@type": "QuantitativeValue",
      "minValue": 1,
      "maxValue": 3,
      "unitCode": "DAY"
    }
  }
}
{%- endcapture -%}

{%- comment -%} 6. Video-Logik {%- endcomment -%}
{%- assign video_json = "" -%}
{%- assign product_video = product.media | where: 'media_type', 'video' | first -%}
{%- if product_video -%}
  {%- capture video_json -%}
  ,
  "video": {
    "@type": "VideoObject",
    "name": "{{ product.title | escape }} - Video",
    "description": "Video zu {{ product.title | escape }}",
    "thumbnailUrl": "https:{{ product_video.preview_image | image_url: width: 800 }}",
    "uploadDate": "{{ product.published_at | date: '%Y-%m-%dT%H:%M:%S%:z' }}",
    "contentUrl": "{{ product_video.sources.last.url }}"
  }
  {%- endcapture -%}
{%- endif -%}

{%- comment -%} 7. Zielgruppen-Logik {%- endcomment -%}
{%- assign audience_type = "Kaffeeliebhaber & Specialty Coffee Fans" -%}
{%- for tag in product.tags -%}
  {%- if tag contains 'Einsteiger' -%}{%- assign audience_type = "Kaffee-Einsteiger" -%}{%- endif -%}
  {%- if tag contains 'Barista' -%}{%- assign audience_type = "Home-Baristas & Kaffee-Profis" -%}{%- endif -%}
  {%- if tag contains 'Büro' -%}{%- assign audience_type = "Büros & Unternehmen" -%}{%- endif -%}
{%- endfor -%}

{%- comment -%} 8. GTIN/Barcode {%- endcomment -%}
{%- assign gtin_value = selected_variant.barcode -%}

{%- comment -%} 9. Preis gültig bis (1 Jahr in Zukunft) {%- endcomment -%}
{%- assign price_valid_until = 'now' | date: '%s' | plus: 31536000 | date: '%Y-%m-%d' -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "@id": "{{ shop.url }}{{ product.url }}#product",
  "name": "{{ product.title | escape }}",
  "url": "{{ shop.url }}{{ product.url }}",
  "description": "{{ product.description | strip_html | strip_newlines | truncatewords: 50 | escape }}",
  "sku": "{{ selected_variant.sku | default: product.id }}",
  "mpn": "{{ product.id }}",
  {%- if gtin_value != blank %}
  "gtin13": "{{ gtin_value }}",
  {%- endif %}
  "inLanguage": "de-DE",
  "brand": {
    "@type": "Brand",
    "name": "{{ product.vendor | escape }}"
  },
  "image": [
    "{{ image_1 }}",
    "{{ image_2 }}"
  ],
  "thumbnail": "{{ thumb_img }}",
  "category": "Specialty Coffee",
  "audience": {
    "@type": "Audience",
    "audienceType": "{{ audience_type }}"
  },
  "offers": {
    "@type": "Offer",
    "availability": "https://schema.org/{{ availability_status }}",
    "priceCurrency": "{{ cart.currency.iso_code }}",
    "price": "{{ selected_variant.price | money_without_currency | replace: ',', '.' | strip }}",
    "priceValidUntil": "{{ price_valid_until }}",
    "itemCondition": "https://schema.org/NewCondition",
    "url": "{{ shop.url }}{{ product.url }}",
    "seller": {
      "@type": "Organization",
      "name": "Brew Blend"
    }{{ return_policy_json }}{{ shipping_json }}
  }{{ rating_json }}{{ video_json }}
}
</script>

{%- comment -%} 🟢 Breadcrumb Schema {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "{{ shop.url }}"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "{{ product.title | escape }}",
      "item": "{{ shop.url }}{{ product.url }}"
    }
  ]
}
</script>
{%- endif -%}