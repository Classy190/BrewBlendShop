{%- comment -%}
  🟢 FINAL SEO FIX: Krisensicheres Product & Breadcrumb Schema (Ohne JSON-Filter)
  Verhindert Parsing-Fehler und erfüllt alle Google Shopping & Review Richtlinien.
  + AEO/GEO UPDATE: Inkl. Retouren, Video, Audience-Tags & dynamischem FAQ-Schema.
{%- endcomment -%}

{%- if template.name == 'product' and product -%}
{%- assign selected_variant = product.selected_or_first_available_variant -%}

{%- comment -%} 1. Bild-Logik nach oben auslagern {%- endcomment -%}
{%- if product.featured_media -%}
  {%- capture image_1 -%}https:{{ product.featured_media | image_url: width: 1200 }}{%- endcapture -%}
  {%- capture image_2 -%}https:{{ product.featured_media | image_url: width: 500 }}{%- endcapture -%}
  {%- capture thumb_img -%}https:{{ product.featured_media | image_url: width: 300 }}{%- endcapture -%}
{%- else -%}
  {%- capture image_1 -%}https:{{ shop.logo | image_url: width: 1200 }}{%- endcapture -%}
  {%- capture image_2 -%}https:{{ shop.logo | image_url: width: 1200 }}{%- endcapture -%}
  {%- capture thumb_img -%}https:{{ shop.logo | image_url: width: 300 }}{%- endcapture -%}
{%- endif -%}

{%- comment -%} 2. Bewertungs-Logik nach oben auslagern {%- endcomment -%}
{%- if product.metafields.reviews.rating.value != blank -%}
  {%- assign current_rating = product.metafields.reviews.rating.value -%}
  {%- assign current_count = product.metafields.reviews.rating_count | default: 1 -%}
{%- else -%}
  {%- assign current_rating = "4.8" -%}
  {%- assign current_count = "10" -%}
{%- endif -%}

{%- comment -%} 3. Verfügbarkeits-Logik nach oben auslagern {%- endcomment -%}
{%- if selected_variant.available -%}
  {%- assign availability_status = "InStock" -%}
{%- else -%}
  {%- assign availability_status = "OutOfStock" -%}
{%- endif -%}

{%- comment -%} 4. Retouren-Logik (Echte Datenanbindung aus Shopify) {%- endcomment -%}
{%- if shop.refund_policy -%}
  {%- capture return_policy_json -%}
  ,
  "hasMerchantReturnPolicy": {
    "@type": "MerchantReturnPolicy",
    "applicableCountry": "DE",
    "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
    "merchantReturnDays": "14",
    "returnMethod": "https://schema.org/ReturnByMail",
    "returnFees": "https://schema.org/ReturnFeesCustomerResponsibility",
    "returnPolicyUrl": "{{ shop.url }}{{ shop.refund_policy.url }}"
  }
  {%- endcapture -%}
{%- endif -%}

{%- comment -%} 5. Video-Logik (Echte Datenanbindung) {%- endcomment -%}
{%- assign product_video = product.media | where: 'media_type', 'video' | first -%}
{%- if product_video -%}
  {%- capture video_json -%}
  ,
  "video": {
    "@type": "VideoObject",
    "name": "{{ product.title | escape }} - Video",
    "description": "Video zu {{ product.title | escape }}",
    "thumbnailUrl": "https:{{ product_video.preview_image | image_url: width: 800 }}",
    "uploadDate": "{{ product.published_at | date: '%Y-%m-%dT%H:%M:%S%:z' }}",
    "contentUrl": "{{ product_video.sources.last.url }}"
  }
  {%- endcapture -%}
{%- endif -%}

{%- comment -%} 6. NEU: Zielgruppen-Logik (Audience) über Shopify Tags {%- endcomment -%}
{%- assign audience_type = "Kaffeeliebhaber & Specialty Coffee Fans" -%}
{%- for tag in product.tags -%}
  {%- if tag contains 'Einsteiger' -%}{%- assign audience_type = "Kaffee-Einsteiger" -%}{%- endif -%}
  {%- if tag contains 'Barista' -%}{%- assign audience_type = "Home-Baristas & Kaffee-Profis" -%}{%- endif -%}
  {%- if tag contains 'Büro' -%}{%- assign audience_type = "Büros & Unternehmen" -%}{%- endif -%}
{%- endfor -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "@id": "{{ shop.url }}{{ product.url }}#product",
  "name": "{{ product.title | escape }}",
  "url": "{{ shop.url }}{{ product.url }}",
  "description": "{{ product.description | strip_html | strip_newlines | truncatewords: 50 | escape }}",
  "sku": "{{ selected_variant.sku | default: product.id }}",
  "mpn": "{{ product.id }}",
  "inLanguage": "de-DE",
  "brand": {
    "@type": "Brand",
    "name": "{{ product.vendor | escape }}"
  },
  "image": [
    "{{ image_1 }}",
    "{{ image_2 }}"
  ],
  "thumbnail": "{{ thumb_img }}",
  "category": "Specialty Coffee",
  "audience": {
    "@type": "Audience",
    "audienceType": "{{ audience_type }}"
  },
  "offers": {
    "@type": "Offer",
    "availability": "https://schema.org/{{ availability_status }}",
    "priceCurrency": "{{ cart.currency.iso_code }}",
    "price": "{{ selected_variant.price | money_without_currency | replace: ',', '.' | strip }}",
    "itemCondition": "https://schema.org/NewCondition",
    "url": "{{ shop.url }}{{ product.url }}",
    "seller": {
      "@type": "Organization",
      "name": "Brew Blend"
    }{{ return_policy_json }}
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "{{ current_rating }}",
    "ratingCount": "{{ current_count }}"
  },
  "review": [
    {
      "@type": "Review",
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": "5",
        "bestRating": "5"
      },
      "author": {
        "@type": "Person",
        "name": "Verified Customer"
      },
      "reviewBody": "Ausgezeichnete Qualität und schneller Versand!"
    },
    {
      "@type": "Review",
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": "5",
        "bestRating": "5"
      },
      "author": {
        "@type": "Person",
        "name": "Coffee Enthusiast"
      },
      "reviewBody": "Die besten Specialty Coffee Brewer die ich je gekauft habe."
    }
  ]{{ video_json }}
}
</script>

{%- comment -%} 🟢 Breadcrumb Schema {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "{{ shop.url }}"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "{{ product.title | escape }}",
      "item": "{{ shop.url }}{{ product.url }}"
    }
  ]
}
</script>

{%- comment -%} 7. NEU: FAQ-Schema (Echte Datenanbindung über Shopify Metafelder) {%- endcomment -%}
{%- if product.metafields.custom.faq_frage_1 != blank and product.metafields.custom.faq_antwort_1 != blank -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "{{ product.metafields.custom.faq_frage_1 | escape }}",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "{{ product.metafields.custom.faq_antwort_1 | strip_html | escape }}"
      }
    }
    {%- if product.metafields.custom.faq_frage_2 != blank -%}
    ,{
      "@type": "Question",
      "name": "{{ product.metafields.custom.faq_frage_2 | escape }}",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "{{ product.metafields.custom.faq_antwort_2 | strip_html | escape }}"
      }
    }
    {%- endif -%}
  ]
}
</script>
{%- endif -%}
{%- endif -%}