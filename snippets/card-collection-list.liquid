{% comment %}
  Renders a collection card

  Accepts:
  - card_collection: {Object} Collection Liquid object
  - media_aspect_ratio: {String} Values: "square", "portrait", "adapt"
  - columns: {Number}
  - extend_height: {Boolean}
  - wrapper_class: {String}
  - placeholder_image: {String}
  - card_index: {Number}
  - image_loading: {String} "lazy" or "eager"
  - fetch_priority: {String} "auto" or "high"
  - image_widths: {String} comma-separated widths
  - image_sizes: {String} sizes attribute

  Usage:
  {% render 'card-collection' %}
{% endcomment %}

{%- liquid
  assign ratio = 1

  if card_collection.featured_image and media_aspect_ratio == 'portrait'
    assign ratio = 0.8
  elsif card_collection.featured_image and media_aspect_ratio == 'adapt'
    assign ratio = card_collection.featured_image.aspect_ratio
  endif

  if ratio == 0 or ratio == null
    assign ratio = 1
  endif

  assign card_color_scheme = settings.card_color_scheme
  assign card_style = settings.card_style

  if wrapper_class == blank or wrapper_class == 'none'
    assign card_color_scheme = settings.collection_card_color_scheme
    assign card_style = settings.collection_card_style
  endif

  assign image_loading_value = image_loading | default: 'lazy'
  assign fetch_priority_value = fetch_priority | default: 'auto'

  if image_loading == blank
    if card_index != blank and card_index <= 2
      assign image_loading_value = 'eager'
      assign fetch_priority_value = 'high'
    else
      assign image_loading_value = 'lazy'
      assign fetch_priority_value = 'auto'
    endif
  endif

  assign collection_image_widths = image_widths | default: '165, 240, 320, 380, 450, 550, 650'
  assign collection_image_sizes = image_sizes | default: '(max-width: 749px) calc((100vw - 3rem) / 2), (max-width: 989px) calc((100vw - 6rem) / 3), 381px'
  assign widths_array = collection_image_widths | split: ','

  assign image_src_width = 450

  if columns == 1
    assign image_src_width = 650
  elsif columns == 2
    assign image_src_width = 550
  else
    assign image_src_width = 450
  endif
-%}

<div class="card-wrapper animate-arrow {% if wrapper_class and wrapper_class != 'none' %}{{ wrapper_class }}{% else %}collection-card-wrapper{% endif %}">
  <div
    class="
      card
      card--{{ card_style }}
      {% if card_collection.featured_image %} card--media{% else %} card--text{% endif %}
      {% if card_style == 'card' %} color-{{ card_color_scheme }} gradient{% endif %}
      {% if extend_height %} card--extend-height{% endif %}
      {% if card_collection.featured_image == nil and card_style == 'card' %} ratio{% endif %}
    "
    style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%;"
  >
    <div
      class="lumin-collection-card-{{ section.id }} card__inner {% if card_style == 'standard' %}color-{{ card_color_scheme }} gradient{% endif %}{% if card_collection.featured_image or card_style == 'standard' %} ratio{% endif %}"
      style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%;"
    >
      {%- if card_collection.featured_image -%}
        {%- liquid
          assign image_alt = card_collection.featured_image.alt | default: card_collection.title | escape
        -%}

        <div class="card__media">
          <div class="media media--transparent media--hover-effect">
            <img
              srcset="
                {%- for width_item in widths_array -%}
                  {%- assign width_number = width_item | strip | plus: 0 -%}
                  {{ card_collection.featured_image | image_url: width: width_number }} {{ width_number }}w{%- unless forloop.last -%}, {%- endunless -%}
                {%- endfor -%}
              "
              src="{{ card_collection.featured_image | image_url: width: image_src_width }}"
              sizes="{{ collection_image_sizes }}"
              alt="{{ image_alt }}"
              title="{{ image_alt }}"
              height="{{ card_collection.featured_image.height }}"
              width="{{ card_collection.featured_image.width }}"
              loading="{{ image_loading_value }}"
              fetchpriority="{{ fetch_priority_value }}"
              decoding="async"
              class="motion-reduce"
            >
          </div>
        </div>
      {%- endif -%}

      {%- if card_collection == blank -%}
        <div class="card__media">
          {{ placeholder_image | placeholder_svg_tag: 'placeholder-svg' }}
        </div>

        <div class="card__content">
          <div class="card__information">
            <h3 class="card__heading{% if section.settings.subtitle_center %} text-center{% endif %}">
              <a
                role="link"
                aria-disabled="true"
                class="full-unstyled-link"
              >
                {{ 'onboarding.collection_title' | t }}
                {%- if section.settings.show_arrow -%}
                  <span class="icon-wrap">{% render 'icon-arrow' %}</span>
                {%- endif -%}
              </a>
            </h3>
          </div>
        </div>
      {%- endif -%}
    </div>

    {%- if card_collection != blank and card_style == 'card' or card_collection.featured_image -%}
      <div class="card__content">
        <div class="card__information">
          <h3 class="card__heading{% if section.settings.subtitle_center %} text-center{% endif %}">
            <a
              {% if card_collection == blank %}
                role="link" aria-disabled="true"
              {% else %}
                href="{{ card_collection.url }}"
                title="{{ card_collection.title | escape }}"
              {% endif %}
              class="full-unstyled-link"
            >
              {%- if card_collection.title != blank -%}
                {{- card_collection.title | escape -}}
              {%- else -%}
                {{ 'onboarding.collection_title' | t }}
              {%- endif -%}

              {%- if card_collection.featured_image or card_collection.description == blank -%}
                {%- if section.settings.show_arrow -%}
                  <span class="icon-wrap">{% render 'icon-arrow' %}</span>
                {%- endif -%}
              {%- endif -%}
            </a>
          </h3>

          {%- if card_collection.featured_image == null and card_collection.description != blank -%}
            <p class="card__caption">
              {{- card_collection.description | strip_html | truncatewords: 12 -}}
              {%- if section.settings.show_arrow -%}
                <span class="icon-wrap">&nbsp;{% render 'icon-arrow' %}</span>
              {%- endif -%}
            </p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if card_collection == blank -%}
      <div class="card__content">
        <div class="card__information">
          <h3 class="card__heading card__heading--placeholder{% if section.settings.subtitle_center %} text-center{% endif %}">
            <a role="link" aria-disabled="true" class="full-unstyled-link">
              {{ 'onboarding.collection_title' | t }}
              {%- if section.settings.show_arrow -%}
                <span class="icon-wrap">{% render 'icon-arrow' %}</span>
              {%- endif -%}
            </a>
          </h3>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>